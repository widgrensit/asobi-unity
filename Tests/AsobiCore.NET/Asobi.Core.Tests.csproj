<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Asobi.Tests</RootNamespace>
    <AssemblyName>Asobi.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- RealtimeModels.cs's outbound request POCOs (WsMatchInputPayload etc.)
         have their fields set via object-initializer call sites that live in
         Unity-only files this scoped test project doesn't link - CS0649 is
         a false positive here, not a real unused-field bug. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Runtime\WebSocket\AsobiDispatcher.cs" Link="Source\AsobiDispatcher.cs" />
    <Compile Include="..\..\Runtime\Models\AuthModels.cs" Link="Source\AuthModels.cs" />
    <Compile Include="..\..\Runtime\Models\RealtimeModels.cs" Link="Source\RealtimeModels.cs" />
    <Compile Include="..\..\Runtime\DeviceCredential.cs" Link="Source\DeviceCredential.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Tests\Runtime\Resources\Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
